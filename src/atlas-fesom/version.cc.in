#include "atlas-fesom/version.h"

#define ATLAS_FESOM_MAJOR_VERSION @atlas-fesom_VERSION_MAJOR@
#define ATLAS_FESOM_MINOR_VERSION @atlas-fesom_VERSION_MINOR@
#define ATLAS_FESOM_PATCH_VERSION @atlas-fesom_VERSION_PATCH@

const char* atlas_fesom_git_sha1() {
    return "@atlas-fesom_GIT_SHA1@";
}

const char* atlas_fesom_version() {
    return "@atlas-fesom_VERSION@";
}

const char* atlas_fesom_version_str() {
    return "@atlas-fesom_VERSION_STR@";
}

unsigned int atlas_fesom_version_int() {
    return 10000 * ATLAS_FESOM_MAJOR_VERSION + 100 * ATLAS_FESOM_MINOR_VERSION + 1 * ATLAS_FESOM_PATCH_VERSION;
}
